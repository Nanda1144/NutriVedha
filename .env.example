# ==============================================================================
# NUTRIVEDHA (AyurAI Health) - Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# APP CORE
VITE_APP_NAME=NutriVedha
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_APP_PORT=5173
VITE_APP_BASE_URL=http://localhost:5173
VITE_APP_SECRET_KEY=
VITE_APP_LOG_LEVEL=debug

# AUTH SERVICE — backend-only secrets (never VITE_ prefix, never exposed to frontend)
AUTH_JWT_SECRET=change-me-in-production-use-64-random-chars
AUTH_JWT_EXPIRY=15m
AUTH_REFRESH_TOKEN_EXPIRY=30d
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Frontend auth URL (Vite-exposed, safe)
VITE_AUTH_SERVICE_URL=http://localhost:3001/api/auth
# Legacy VITE_ JWT vars kept for backward compat (prefer AUTH_ above)
VITE_AUTH_JWT_SECRET=
VITE_AUTH_JWT_EXPIRY=15m

# AI / ML SERVICE (Gemini)
VITE_AI_SERVICE_URL=http://localhost:3003/api/ai
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash
VITE_GEMINI_TEMPERATURE=0.7

# DATABASE SERVICE (PostgreSQL — primary)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrivedha
PGHOST=localhost
PGPORT=5432
PGDATABASE=nutrivedha
PGUSER=postgres
PGPASSWORD=postgres
PG_POOL_SIZE=10
# Legacy Mongo (kept for reference; PostgreSQL is used)
MONGODB_URI=mongodb://localhost:27017/nutrivedha
MONGODB_URI_PROD=mongodb+srv://<username>:<password>@cluster.mongodb.net/nutrivedha
MONGODB_DB_NAME=nutrivedha

# MEDICAL SERVICE — backend-only
MEDICAL_ENCRYPTION_KEY=change-me-32-chars-min
MEDICAL_ENCRYPTION_ALGORITHM=AES-256-GCM
VITE_MEDICAL_SERVICE_URL=http://localhost:3005/api/medical
# Legacy Vite var for compat
VITE_MEDICAL_ENCRYPTION_KEY=

# TELEMEDICINE SERVICE
VITE_TELEMEDICINE_SERVICE_URL=http://localhost:3006/api/telemedicine
VITE_TELEMEDICINE_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# MARKETPLACE SERVICE
VITE_MARKETPLACE_SERVICE_URL=http://localhost:3007/api/marketplace
VITE_MARKETPLACE_RAZORPAY_KEY_ID=
VITE_MARKETPLACE_RAZORPAY_KEY_SECRET=

# DELIVERY SERVICE
VITE_DELIVERY_SERVICE_URL=http://localhost:3008/api/delivery
VITE_DELIVERY_MAPBOX_ACCESS_TOKEN=

# FITNESS SERVICE
VITE_FITNESS_SERVICE_URL=http://localhost:3009/api/fitness
VITE_FITNESS_CLOUDINARY_CLOUD_NAME=
VITE_FITNESS_CLOUDINARY_API_KEY=
VITE_FITNESS_CLOUDINARY_API_SECRET=

# NOTIFICATION SERVICE
VITE_NOTIFICATION_SERVICE_URL=http://localhost:3010/api/notifications
VITE_NOTIFICATION_FIREBASE_PROJECT_ID=
VITE_NOTIFICATION_FIREBASE_API_KEY=

# ANALYTICS & AUDIT
VITE_ANALYTICS_SERVICE_URL=http://localhost:3011/api/analytics
VITE_ANALYTICS_SENTRY_DSN=

# STORAGE SERVICE
VITE_STORAGE_SERVICE_URL=http://localhost:3012/api/storage
VITE_STORAGE_S3_BUCKET=
VITE_STORAGE_S3_ACCESS_KEY=
VITE_STORAGE_S3_SECRET_KEY=

# EMAIL SERVICE
VITE_EMAIL_SERVICE_URL=http://localhost:3013/api/email
VITE_EMAIL_SENDGRID_API_KEY=

# DOCTOR SERVICE
VITE_DOCTOR_SERVICE_URL=http://localhost:3014/api/doctors

# FARMER SERVICE
VITE_FARMER_SERVICE_URL=http://localhost:3012/api/farmer

# ADMIN SERVICE
VITE_ADMIN_SERVICE_URL=http://localhost:3015/api/admin

# SECURITY — backend-only rate limit & CORS (per spec 34, never origin "*")
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:5173
CSRF_SECRET=
# Legacy VITE_ security vars for compat
VITE_RATE_LIMIT_WINDOW_MS=900000
VITE_RATE_LIMIT_MAX_REQUESTS=100
VITE_CORS_ORIGIN=http://localhost:5173
VITE_CSRF_SECRET=

# AUTH — Backend-only JWT & Cookie (per spec 35, never VITE_ exposed)
# Preferred canonical (backend only):
JWT_ACCESS_SECRET=change-me-64-chars-access
JWT_REFRESH_SECRET=change-me-64-chars-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Admin bootstrap — server-side only, env, one-time, never frontend (per spec 27)
ADMIN_BOOTSTRAP_EMAIL=admin@nutrivedha.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
ADMIN_PASSKEYS=@cC1411441,pavan,manil,jyo,janu
